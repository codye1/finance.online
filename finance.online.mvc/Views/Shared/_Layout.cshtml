@inject finance.online.mvc.Services.IComponentAssetManager AssetManager
@inject finance.online.mvc.Services.ICurrentUserService CurrentUserService
@{
    var currentUser = CurrentUserService.GetUser();
    var userAuthenticated = currentUser != null;
    var currentPath = Context.Request.Path.Value ?? "/";
    var navItems = new[]
    {
        new { Path = "/", Icon = "dashboard", Label = "Дашборд" },
        new { Path = "/operations", Icon = "receipt", Label = "Операції" },
        new { Path = "/categories", Icon = "tags", Label = "Категорії" },
        new { Path = "/settings", Icon = "settings", Label = "Налаштування" }
    };
}

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent NavIcon(string icon)
    {
        var svg = icon switch
        {
            "dashboard" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1.5\"></rect><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1.5\"></rect><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1.5\"></rect><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1.5\"></rect></svg>",
            "receipt" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 3v18l2-1.2L8 21l2-1.2 2 1.2 2-1.2 2 1.2 2-1.2L20 21V3l-2 1.2L16 3l-2 1.2L12 3l-2 1.2L8 3 6 4.2 4 3Z\"></path><path d=\"M8 8h8\"></path><path d=\"M8 12h8\"></path><path d=\"M8 16h5\"></path></svg>",
            "tags" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20.5 13.5 13.5 20.5a2.1 2.1 0 0 1-3 0L3 13V4h9l8.5 8.5a2.1 2.1 0 0 1 0 3Z\"></path><path d=\"M7.5 7.5h.01\"></path><path d=\"m14 6 7 7\"></path></svg>",
            "settings" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z\"></path><path d=\"M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21a2 2 0 1 1-4 0v-.1A1.7 1.7 0 0 0 8 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 8a1.7 1.7 0 0 0-.34-1.88l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3a2 2 0 1 1 4 0v.1A1.7 1.7 0 0 0 16 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.16.38.38.73.6 1 .28.28.67.4 1.1.4h.1a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.7.6Z\"></path></svg>",
            "plus" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14\"></path><path d=\"M5 12h14\"></path></svg>",
            _ => string.Empty
        };

        return new Microsoft.AspNetCore.Html.HtmlString(svg);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - finance.online.mvc</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/finance.online.mvc.styles.css" />

    @foreach (var style in AssetManager.GetStyles())
    {
        <link rel="stylesheet" href="@style" />
    }

    @await RenderSectionAsync("Styles", required: false)

    <script>
    (function () {
        var STORAGE_KEY = 'activeOrganizationId';
        var params = new URLSearchParams(window.location.search);
        var urlOrgId = params.get('organizationId');
        var savedOrgId = localStorage.getItem(STORAGE_KEY);

        // якщо в url вже прийшов organizationId - просто запам'ятовуємо його
        if (urlOrgId) {
            localStorage.setItem(STORAGE_KEY, urlOrgId);
            return;
        }

        // якщо в localStorage є збережена організація і вона не в url - редіректимо
        if (savedOrgId) {
            params.set('organizationId', savedOrgId);
            window.location.replace(window.location.pathname + '?' + params.toString());
        }
    })();
</script>
</head>
<body>
    @if (userAuthenticated)
    {
        <div class="app-shell">
            <aside class="app-rail" aria-label="Основна навігація">
                <a class="app-brand" href="/" aria-label="Фінанси">
                    Ф
                </a>

                @foreach (var item in navItems)
                {
                    var isActive = item.Path == "/"
                        ? currentPath == "/"
                        : currentPath.StartsWith(item.Path, StringComparison.OrdinalIgnoreCase);

                    <a href="@item.Path"
                       class="app-nav-link @(isActive ? "is-active" : "")"
                       title="@item.Label"
                       aria-label="@item.Label"
                       aria-current="@(isActive ? "page" : null)">
                        @NavIcon(item.Icon)
                        @if (isActive)
                        {
                            <span class="app-nav-indicator"></span>
                        }
                    </a>
                }
            </aside>

            <div class="app-content">
                <main role="main">
                    @RenderBody()
                </main>
            </div>

            <nav class="app-dock" aria-label="Мобільна навігація">
                <div class="app-dock-inner">
                    @foreach (var item in navItems.Take(2))
                    {
                        var isActive = item.Path == "/"
                            ? currentPath == "/"
                            : currentPath.StartsWith(item.Path, StringComparison.OrdinalIgnoreCase);

                        <a href="@item.Path"
                           class="app-dock-item @(isActive ? "is-active" : "")"
                           aria-current="@(isActive ? "page" : null)">
                            @NavIcon(item.Icon)
                            <span>@item.Label</span>
                        </a>
                    }

                    <button type="button"
                            class="app-dock-action"
                            aria-label="Нова операція"
                            data-open-new-operation>
                        @NavIcon("plus")
                    </button>

                    @foreach (var item in navItems.Skip(2).Take(2))
                    {
                        var isActive = item.Path == "/"
                            ? currentPath == "/"
                            : currentPath.StartsWith(item.Path, StringComparison.OrdinalIgnoreCase);

                        <a href="@item.Path"
                           class="app-dock-item @(isActive ? "is-active" : "")"
                           aria-current="@(isActive ? "page" : null)">
                            @NavIcon(item.Icon)
                            <span>@item.Label</span>
                        </a>
                    }
                </div>
            </nav>
        </div>
    }
    else
    {
        <div class="app-shell app-shell-plain">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }

    <div id="app-modal" class="modal-overlay">
        <div class="modal-window">
            <div class="modal-header">
                <h2 id="modal-title"></h2>
                <button class="js-close-modal" id="js-close-modal"><img src="~/images/icons/close.svg" alt="CloseIcon" /> </button>
            </div>
            <div id="modal-body-content"></div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/helpers/ModalManager.js" type="module" asp-append-version="true"></script>


    @foreach (var script in AssetManager.GetScripts())
    {
        if (script.IsModule)
        {
            <script src="@script.Src" type="module" asp-append-version="true"></script>
        }
        else
        {
            <script src="@script.Src" asp-append-version="true"></script>
        }
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
