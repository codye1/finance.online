@model finance.online.mvc.Models.DTO.CategoryResponseDto

<div class="categories-item" data-category-id="@Model.Id">
    <div class="category-color-dot" style="background-color:@Model.Color;" aria-hidden="true"></div>
    <div class="categories-item-body">
        <div class="categories-item-title">
            <span>@Model.Name</span>
        </div>
    </div>
    <button type="button" class="category-delete-btn" data-category-id="@Model.Id" aria-label="Видалити категорію">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 6h18"></path>
            <path d="M8 6V4h8v2"></path>
            <path d="M19 6l-1 14H6L5 6"></path>
            <path d="M10 11v5"></path>
            <path d="M14 11v5"></path>
        </svg>
    </button>
</div>